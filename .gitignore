# Environment — never commit real secrets
.env

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# Firebase credentials
firebase-credentials.json
firebase-render-env.txt

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Discord Community (Next.js) — source is tracked, deps/build are not
discord-community/node_modules/
discord-community/.next/
discord-community/.env.local

# Flutter/Dart (if present locally)
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/ios/Flutter/.last_build_id
/android/app/debug
/android/app/profile
/android/app/release

# Release binaries — do not commit
*.apk
*.ipa
*.aab
