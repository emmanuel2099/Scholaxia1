# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Scholaxia
DEBUG=False
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (Render PostgreSQL — auto-set on Render, fill manually for local) ─
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scholaxia

# ── Redis (Render Redis add-on URL or local) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Cloudinary (Media Storage — books, videos, images, assignments) ───────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email OTP provider: gmail | sendgrid | mailgun | brevo ────────────────────
# Use gmail when From is @gmail.com (best inbox delivery).
# Use sendgrid only with an authenticated custom domain (not @gmail.com).
EMAIL_PROVIDER=gmail
OTP_EXPIRE_MINUTES=10

# Gmail SMTP — Google Account → Security → 2-Step Verification → App passwords
GMAIL_SMTP_EMAIL=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_NAME=Scholaxia

# SendGrid (custom domain only)
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_SENDER_NAME=Scholaxia

# Brevo (legacy fallback)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@scholaxia.com
BREVO_SENDER_NAME=Scholaxia

# Mailgun (OTP Email — alternative)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=
MAILGUN_SENDER_NAME=Scholaxia

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Flutterwave (Live class pay-before-join) ─────────────────────────────────
# Test keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
LIVE_CLASS_JOIN_AMOUNT=2000
LIVE_CLASS_MONTHLY_DAYS=30

# ── Paystack (Library books, CBT packages, class packages) ───────────────────
# Test keys from https://dashboard.paystack.com/#/settings/developers
# Webhook URL: https://<your-api>/api/v1/payments/paystack/webhook
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Optional: browser redirect after checkout (leave blank for mobile SDK flows)
PAYSTACK_CALLBACK_URL=

# Sample CBT exams are off by default (admin uploads real content).
SEED_SAMPLE_CBT=false

# ── Firebase (Push Notifications) ─────────────────────────────────────────────
# Local: save service account JSON as firebase-credentials.json
# Render: paste minified JSON into FIREBASE_CREDENTIALS_JSON env var
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=

# Desktop client uses firebase-config.js (Web app: Scholaxia Desktop)
# Project: scholaxia1 | Sender ID: 685796212734

# ── ALOC CBT Past Questions ───────────────────────────────────────────────────
# Option A — use questions.aloc.com.ng (free plan has API quota limits)
# Option B — self-host aloc-endpoints (see aloc-endpoints repo) for unlimited calls:
#   1. php artisan migrate && import question SQL into MySQL
#   2. Set ALOC_SELF_HOSTED=true in aloc .env, create an access token in admin
#   3. Point Scholaxia at your server:
#      ALOC_BASE_URL=https://your-aloc-server.com
#      ALOC_ACCESS_TOKEN=your-local-token
ALOC_ACCESS_TOKEN=
ALOC_BASE_URL=https://questions.aloc.com.ng
# Optional: pin UTME year (e.g. 2010). Leave blank for mixed years per subject.
ALOC_DEFAULT_YEAR=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple OAuth ───────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── AI tutors (Sia / Teacher AI / Kind) ───────────────────────────────────────
# openai | gemini | deepseek | groq | hosted | local
# Prefer deepseek for Scholaxia tutors (fallback: openai → gemini → groq).
AI_BACKEND=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.42

# Optional premium voice (if empty, Edge TTS + gTTS free fallbacks are used)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Hosted / local (only if AI_BACKEND=hosted|local)
AI_LOCAL_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
AI_LOCAL_DEVICE=cpu
AI_HOSTED_BASE_URL=http://localhost:11434
AI_HOSTED_MODEL_NAME=scholaxia-edu
AI_HOSTED_API_KEY=
AI_HOSTED_ENDPOINT_TYPE=ollama

# ── LiveKit (Live class video / audio / screen share) ─────────────────────────
# From https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@scholaxia.com
ADMIN_PASSWORD=changeme

# Re-seed sample WAEC/NECO/JAMB CBT exams on every startup (default false).
# Leave false so deleted samples stay deleted; admins can still seed manually
# from the dashboard (POST /api/v1/admin/seed-cbt).
SEED_SAMPLE_CBT=false
